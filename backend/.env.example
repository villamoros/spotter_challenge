# Copia este archivo a .env y completa los valores. .env no se sube al repositorio.

# Clave de OpenRouteService (perfil de camión). Obtenla en https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# 1 usa datos sintéticos sin clave; 0 usa OpenRouteService y Open-Meteo reales.
SPOTTER_DEMO=0

# Opcional: identifica la app ante Nominatim (geocodificación).
NOMINATIM_USER_AGENT=SpotterRiskLab/1.0 (tu-correo@ejemplo.com)
